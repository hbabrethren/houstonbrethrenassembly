# Houston Brethren Assembly technical SEO / performance defaults
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS on Apache hosting.
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Canonical host: non-www.
  RewriteCond %{HTTP_HOST} ^www\.houstonbrethrenassembly.com$ [NC]
  RewriteRule ^ https://houstonbrethrenassembly.com%{REQUEST_URI} [L,R=301]
</IfModule>

# Preserve equity from legacy WordPress-style paths.
Redirect 301 /contact/ https://houstonbrethrenassembly.com/#contact
Redirect 301 /to-contact/ https://houstonbrethrenassembly.com/#contact
Redirect 301 /our-meetings/ https://houstonbrethrenassembly.com/#meetings
Redirect 301 /upcoming-meetings/ https://houstonbrethrenassembly.com/#meetings
Redirect 301 /monthly-schedule/ https://houstonbrethrenassembly.com/#meetings
Redirect 301 /statement-of-faith/ https://houstonbrethrenassembly.com/#faith
Redirect 301 /our-vision/ https://houstonbrethrenassembly.com/#vision
Redirect 301 /our-mission/ https://houstonbrethrenassembly.com/#mission
Redirect 301 /our-story/ https://houstonbrethrenassembly.com/#story
Redirect 301 /plymouth-brethren/ https://houstonbrethrenassembly.com/#story
Redirect 301 /kerala-brethren-history/ https://houstonbrethrenassembly.com/#story
Redirect 301 /homepage/ https://houstonbrethrenassembly.com/#home

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_mime.c>
  AddType image/svg+xml .svg
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 1 day"
</IfModule>
